{
  "name": "tailor-dev-kit",
  "private": true,
  "description": "Tailor Development Kit - Workspace Root",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm run build && pnpm -r run test",
    "dev": "pnpm -r run dev",
    "generate": "pnpm run build && pnpm -r run generate",
    "deploy": "pnpm run build && pnpm -r run deploy",
    "actions:lock:install": "gh extension install github/gh-actions-lock --pin \"$(node -p \"require('./renovate.json').constraints.ghActionsLock\")\" --force",
    "actions:lock:update": "pnpm run actions:lock:install && gh actions-lock --no-narrow",
    "actions:lock:check": "pnpm run actions:lock:install && gh actions-lock --verify",
    "agent:rules:update": "node scripts/sync-agent-rules.mjs --write",
    "agent:rules:check": "node scripts/sync-agent-rules.mjs --check",
    "codemod:docs:update": "tsx packages/sdk-codemod/scripts/sync-codemod-docs.ts --write",
    "codemod:docs:check": "tsx packages/sdk-codemod/scripts/sync-codemod-docs.ts --check",
    "codemod:resolve-pending": "tsx packages/sdk-codemod/scripts/resolve-pending-boundaries.ts",
    "deprecations:resolve-pending": "tsx packages/sdk-codemod/scripts/resolve-pending-deprecations.ts",
    "setup:template-version:resolve-pending": "TEMPLATE_VERSION_RELEASE=1 pnpm --filter @tailor-platform/sdk-plugin-setup exec vitest run src/template-fingerprint.test.ts",
    "check": "pnpm run generate && pnpm run format && pnpm run \"/^check:/\"",
    "check:agent-rules": "pnpm run agent:rules:check",
    "check:codemod-docs": "pnpm run codemod:docs:check",
    "check:deprecations": "tsx packages/sdk-codemod/scripts/check-deprecations.ts",
    "check:lint": "pnpm -r run lint:fix && pnpm run lint:tooling:fix && pnpm run lint:vitest",
    "check:typecheck": "pnpm run --no-bail \"/^check-type:/\"",
    "check-type:root": "pnpm run typecheck:root",
    "check-type:rust": "pnpm --no-bail -r run typecheck:rs",
    "check-type:stable": "pnpm --filter=!example --no-bail -r run typecheck",
    "check-type:example": "pnpm --filter example run typecheck:generated",
    "check:knip": "pnpm -r run knip",
    "check:publint": "pnpm -r run publint",
    "check:jsdoc": "pnpm -r run check:public-api-jsdoc",
    "check:zod-isolation": "pnpm -r run check:zod-isolation",
    "check:import-cycles": "pnpm -r run check:import-cycles",
    "lint": "pnpm run build && pnpm -r run lint && pnpm run lint:tooling && pnpm run lint:vitest",
    "lint:fix": "pnpm run build && pnpm -r run lint:fix && pnpm run lint:tooling:fix && pnpm run lint:vitest:fix",
    "lint:tooling": "oxlint --config oxlint.shared.json .agents/skills .github/scripts scripts",
    "lint:tooling:fix": "oxlint --config oxlint.shared.json .agents/skills .github/scripts scripts --fix",
    "lint:vitest": "oxlint --config oxlint.vitest.json .",
    "lint:vitest:fix": "oxlint --config oxlint.vitest.json . --fix",
    "knip": "pnpm run build && pnpm -r run knip",
    "publint": "pnpm run build && pnpm -r run publint",
    "typecheck:rs": "pnpm run build && pnpm --filter @tailor-platform/sdk --filter example run generate && pnpm -r run typecheck:rs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm run generate && pnpm -r run typecheck",
    "typecheck:root": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.19.2",
    "eslint-plugin-zod": "5.2.0",
    "knip": "6.42.1",
    "lefthook": "2.2.1",
    "madge": "8.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "pkg-pr-new": "0.0.91",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "packageManager": "pnpm@12.14.0"
}

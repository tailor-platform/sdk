#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$*" >>"$E2E_PNPM_MARKER"

signal_cleanup_stage() {
  local stage=$1
  if [[ ${E2E_CLEANUP_DELAY_AT:-} == "$stage" ]]; then
    if [[ -n ${E2E_CLEANUP_STARTED_MARKER:-} ]]; then
      printf 'started' >"$E2E_CLEANUP_STARTED_MARKER"
    fi
    if [[ -n ${E2E_CLEANUP_PID_MARKER:-} ]]; then
      printf '%s' "$$" >"$E2E_CLEANUP_PID_MARKER"
    fi
    /bin/sleep "${E2E_CLEANUP_DELAY:-1}"
    if [[ -n ${E2E_CLEANUP_COMPLETION_MARKER:-} ]]; then
      printf 'completed' >"$E2E_CLEANUP_COMPLETION_MARKER"
    fi
  fi
  if [[ ${E2E_CLEANUP_SIGNAL_AT:-} == "$stage" ]]; then
    kill -s "${E2E_CLEANUP_SIGNAL:-TERM}" "$PPID"
    if [[ -n ${E2E_CLEANUP_SIGNAL_EXIT_IMMEDIATELY:-} ]]; then
      exit 0
    fi
    /bin/sleep 0.1
  fi
}

case "$*" in
  "run test -- --project e2e")
    if [[ -n ${E2E_TEST_STARTED_MARKER:-} ]]; then
      printf 'started' >"$E2E_TEST_STARTED_MARKER"
    fi
    if [[ -n ${E2E_TEST_PID_MARKER:-} ]]; then
      printf '%s' "$$" >"$E2E_TEST_PID_MARKER"
    fi
    if [[ -n ${E2E_RUN_ID_MARKER:-} ]]; then
      printf '%s' "${TAILOR_PLATFORM_E2E_RUN_ID:-}" >"$E2E_RUN_ID_MARKER"
    fi
    if [[ -n ${E2E_TMPDIR_MARKER:-} ]]; then
      printf '%s' "${TMPDIR:-}" >"$E2E_TMPDIR_MARKER"
    fi
    if [[ -n ${E2E_TEST_SIGNAL:-} ]]; then
      kill -s "$E2E_TEST_SIGNAL" "$PPID"
      /bin/sleep "${E2E_SIGNAL_DELAY:-1}"
      if [[ -n ${E2E_SIGNAL_COMPLETION_MARKER:-} ]]; then
        printf 'completed' >"$E2E_SIGNAL_COMPLETION_MARKER"
      fi
    fi
    if [[ -n ${E2E_TEST_DELAY:-} ]]; then
      /bin/sleep "$E2E_TEST_DELAY"
    fi
    if [[ -n ${E2E_TEST_COMPLETION_MARKER:-} ]]; then
      printf 'completed' >"$E2E_TEST_COMPLETION_MARKER"
    fi
    exit "${E2E_TEST_STATUS:-0}"
    ;;
  "exec tsx scripts/cleanup-e2e-workspaces.ts --dry-run --run-id="*)
    signal_cleanup_stage preview
    preview_count=$(grep -c -- '--dry-run' "$E2E_PNPM_MARKER")
    if [[ $preview_count -eq 1 ]]; then
      echo "Found a workspace for this run"
      exit "${E2E_PREVIEW_STATUS:-0}"
    fi
    if [[ -n ${E2E_RESIDUAL_WORKSPACE:-} ]]; then
      echo "Found 1 e2e workspace(s):"
    elif [[ -n ${E2E_VERIFY_MISSING:-} ]]; then
      :
    elif [[ -n ${E2E_VERIFY_MALFORMED:-} ]]; then
      echo "✅ No e2e workspaces found to delete."
      echo "Found 1 e2e workspace(s):"
    else
      echo "✅ No e2e workspaces found to delete."
    fi
    exit "${E2E_VERIFY_STATUS:-0}"
    ;;
  "exec tsx scripts/cleanup-e2e-workspaces.ts --run-id="*)
    signal_cleanup_stage delete
    exit "${E2E_CLEANUP_STATUS:-0}"
    ;;
  "exec tailor-sdk --json workspace list")
    if [[ -n ${TAILOR_PLATFORM_PROFILE:-} ]]; then
      echo "workspace verification inherited TAILOR_PLATFORM_PROFILE" >&2
      exit 27
    fi
    if [[ -n ${E2E_RAW_MISSING:-} ]]; then
      :
    elif [[ -n ${E2E_RAW_MALFORMED:-} ]]; then
      printf '{"not":"a workspace list"}\n'
    elif [[ -n ${E2E_RAW_AMBIGUOUS:-} ]]; then
      printf '[{"name":"template-e2e-%s-leftover"}]\n' "$TAILOR_PLATFORM_E2E_RUN_ID"
    elif [[ -n ${E2E_RAW_RESIDUAL:-} ]]; then
      printf '[{"name":"e2e-ws-%s-leftover"}]\n' "$TAILOR_PLATFORM_E2E_RUN_ID"
    elif [[ -n ${E2E_RAW_OTHER_RUN:-} ]]; then
      printf '[{"name":"e2e-ws-other-run-12345-leftover"}]\n'
    else
      printf '[]\n'
    fi
    raw_count=$(grep -c -- 'exec tailor-sdk --json workspace list' "$E2E_PNPM_MARKER")
    if [[ $raw_count -eq 1 ]]; then
      signal_cleanup_stage pre-audit
    else
      signal_cleanup_stage post-audit
    fi
    exit "${E2E_RAW_STATUS:-0}"
    ;;
  *)
    exit 99
    ;;
esac

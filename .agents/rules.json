{
  "rules": [
    {
      "name": "changeset",
      "paths": [".changeset/**"],
      "file": ".agents/rules/changeset.md"
    },
    {
      "name": "cli-logging",
      "paths": ["packages/sdk/src/cli/**/*.ts"],
      "file": ".agents/rules/cli-logging.md"
    },
    {
      "name": "code-comments",
      "paths": ["**"],
      "file": ".agents/rules/code-comments.md"
    },
    {
      "name": "deploy-managed-resources",
      "paths": [
        "packages/sdk/src/cli/commands/deploy/apply-phases.ts",
        "packages/sdk/src/cli/commands/deploy/managed-resource-type.ts"
      ],
      "file": ".agents/rules/deploy-managed-resources.md"
    },
    {
      "name": "deprecation",
      "paths": ["packages/sdk/src/**/*.ts", "packages/sdk-codemod/src/registry.ts"],
      "file": ".agents/rules/deprecation.md"
    },
    {
      "name": "docs-authoring",
      "paths": ["packages/sdk/docs/**", "packages/sdk/src/**/*.ts"],
      "file": ".agents/rules/docs-authoring.md"
    },
    {
      "name": "e2e-tests",
      "paths": ["packages/sdk/e2e/**"],
      "file": ".agents/rules/e2e-tests.md"
    },
    {
      "name": "jsdoc",
      "paths": ["packages/sdk/src/**/*.ts"],
      "file": ".agents/rules/jsdoc.md"
    },
    {
      "name": "schema-types",
      "paths": [
        "packages/sdk/src/types/**/*.ts",
        "packages/sdk/src/parser/**/types.ts",
        "packages/sdk/src/configure/**/types.ts",
        "packages/sdk/src/configure/**/*.types.ts",
        "packages/sdk/src/plugin/types.ts",
        "packages/sdk/src/runtime/types.ts",
        "packages/sdk/src/parser/**/schema.ts",
        "packages/sdk/zinfer.config.ts"
      ],
      "file": ".agents/rules/schema-types.md"
    },
    {
      "name": "sdk-internals",
      "paths": [
        "packages/sdk/src/configure/**/*.ts",
        "packages/sdk/src/parser/**/*.ts",
        "packages/sdk/src/cli/**/*.ts",
        "packages/sdk/src/plugin/**/*.ts",
        "packages/sdk/src/types/**/*.ts"
      ],
      "file": ".agents/rules/sdk-internals.md"
    }
  ]
}

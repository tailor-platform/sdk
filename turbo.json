{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": ["**/.env"],
  "globalPassThroughEnv": [
    "TAILOR_PLATFORM_TOKEN",
    "TAILOR_PLATFORM_WORKSPACE_ID",
    "TAILOR_PLATFORM_PROFILE",
    "TAILOR_PLATFORM_ORGANIZATION_ID",
    "TAILOR_PLATFORM_FOLDER_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "generate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "generate:watch": {
      "dependsOn": ["build"],
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "check": {
      "dependsOn": [
        "format",
        "lint:fix",
        "typecheck:go",
        "knip",
        "publint",
        "check:public-api-jsdoc"
      ],
      "cache": false
    },
    "check:public-api-jsdoc": {
      "cache": true
    },
    "knip": {
      "cache": true
    },
    "publint": {
      "dependsOn": ["build"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["build"],
      "outputs": [".eslintcache"],
      "cache": true
    },
    "lint:fix": {
      "dependsOn": ["build"],
      "outputs": [".eslintcache"],
      "cache": true
    },
    "format": {
      "dependsOn": ["//#format:root"],
      "cache": true
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"],
      "cache": true
    },
    "//#format:root": {
      "cache": true
    },
    "//#format:check:root": {
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["build", "generate"],
      "outputs": [],
      "cache": true
    },
    "typecheck:go": {
      "dependsOn": ["build", "generate"],
      "outputs": [],
      "cache": true
    }
  }
}

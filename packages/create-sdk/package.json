{
  "name": "@tailor-platform/create-sdk",
  "version": "1.60.1",
  "description": "A CLI tool to quickly create a new Tailor Platform SDK project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/create-sdk"
  },
  "bin": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware . --ignore-pattern \"templates/**\"",
    "lint:fix": "oxlint --type-aware . --ignore-pattern \"templates/**\" --fix",
    "typecheck": "tsc --noEmit",
    "prepublish": "node scripts/prepare-templates.js && pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@clack/prompts": "1.5.1",
    "execa": "9.6.1",
    "picocolors": "1.1.1",
    "pkg-types": "2.3.1",
    "politty": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "tsdown": "0.22.2",
    "typescript": "5.9.3"
  }
}

{
  "name": "@tailor-platform/create-sdk",
  "version": "2.12.0",
  "description": "A CLI tool to quickly create a new Tailor Platform SDK project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/create-sdk"
  },
  "bin": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware . --ignore-pattern \"templates/**\"",
    "lint:fix": "oxlint --type-aware . --ignore-pattern \"templates/**\" --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/prepare-templates.js && pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "execa": "10.0.1",
    "picocolors": "1.1.1",
    "pkg-types": "2.3.1",
    "politty": "0.11.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint-plugin-zod": "4.10.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}

{
  "name": "@tailor-platform/create-sdk",
  "version": "2.33.0",
  "description": "A CLI tool to quickly create a new Tailor Platform SDK project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/create-sdk"
  },
  "bin": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware . --ignore-pattern \"templates/**\"",
    "lint:fix": "oxlint --type-aware . --ignore-pattern \"templates/**\" --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "node scripts/prepare-templates.js && pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@politty/zod": "0.6.1",
    "execa": "10.2.0",
    "picocolors": "1.1.1",
    "pkg-types": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint-plugin-zod": "5.2.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

{
  "name": "multi-application",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "pnpm run deploy:user && pnpm run deploy:admin",
    "deploy:user": "tailor-sdk deploy -c apps/user/tailor.config.ts",
    "deploy:admin": "tailor-sdk deploy -c apps/admin/tailor.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.13.2",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "5.9.3"
  }
}

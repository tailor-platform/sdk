{
  "name": "multi-application",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "pnpm run deploy:user && pnpm run deploy:admin",
    "deploy:user": "tailor deploy -c apps/user/tailor.config.ts",
    "deploy:admin": "tailor deploy -c apps/admin/tailor.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailor-platform/eslint-plugin-sdk": "workspace:^",
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.13.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3"
  }
}

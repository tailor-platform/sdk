{
  "name": "multi-application",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "pnpm run deploy:user && pnpm run deploy:admin",
    "deploy:user": "tailor-sdk apply -c apps/user/tailor.config.ts",
    "deploy:admin": "tailor-sdk apply -c apps/admin/tailor.config.ts",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint --type-aware . && eslint --cache .",
    "lint:fix": "vp lint --type-aware --fix . && eslint --cache --fix .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.12.0",
    "eslint": "9.39.4",
    "eslint-plugin-oxlint": "1.39.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite-plus": "catalog:"
  }
}

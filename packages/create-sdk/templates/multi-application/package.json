{
  "name": "multi-application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "pnpm run deploy:user && pnpm run deploy:admin",
    "deploy:user": "tailor-sdk deploy -c apps/user/tailor.config.ts",
    "deploy:admin": "tailor-sdk deploy -c apps/admin/tailor.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailor-platform/eslint-plugin-sdk": "workspace:^",
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.13.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "6.0.3"
  }
}

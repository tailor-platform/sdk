{
  "name": "inventory-management",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "tailor-sdk apply",
    "generate": "tailor-sdk generate",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware . && eslint --cache .",
    "lint:fix": "oxlint --type-aware --fix . && eslint --cache --fix .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailor-platform/function-types": "0.8.2",
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.12.0",
    "eslint": "9.39.4",
    "eslint-plugin-oxlint": "1.55.0",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.16.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  }
}

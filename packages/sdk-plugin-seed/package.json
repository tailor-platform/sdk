{
  "name": "@tailor-platform/sdk-plugin-seed",
  "version": "0.6.1",
  "description": "Tailor CLI plugin providing the `tailor seed` commands (TailorDB and IdP seed data)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk-plugin-seed"
  },
  "bin": {
    "tailor-seed": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && politty generate-shim --entry ../dist/index.js",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@politty/zod": "0.6.1",
    "pathe": "2.0.3",
    "pkg-types": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@tailor-platform/sdk": "workspace:^"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.18.0"
  }
}

{
  "name": "@tailor-platform/sdk-plugin-setup",
  "version": "0.13.1",
  "description": "Tailor CLI plugin providing the `tailor setup` commands (repository automation setup)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk-plugin-setup"
  },
  "bin": {
    "tailor-setup": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && politty generate-shim --entry ../dist/cli.js",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@croct/json5-parser": "0.2.2",
    "@politty/zod": "0.6.0",
    "json5": "2.2.3",
    "pathe": "2.0.3",
    "pkg-types": "2.4.0",
    "std-env": "4.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.19.2",
    "confbox": "0.3.1",
    "eslint-plugin-zod": "5.2.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@tailor-platform/sdk": "workspace:^"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.18.0"
  }
}

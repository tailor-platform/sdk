# Generated by `tailor setup` — managed by the Tailor SDK.
#
# - The SDK manages the jobs and steps whose id starts with `tailor-` and the
#   top-level name, on, and permissions. Do not edit or rename them:
#   `tailor setup check` reports it, and re-running `tailor setup` then needs
#   --force.
# - Give the jobs and steps you add ids that do not start with `tailor-`:
#   the prefix is reserved for the SDK, and `tailor setup` stops on it.
# - Re-running `tailor setup` keeps your own jobs and steps, every other
#   top-level key, and runs-on, timeout-minutes, container, and env on managed
#   jobs and the ignore, fail-on-drift, install-command, node-version-file,
#   label, ttl, and user-mapping inputs of managed steps.
# - State is tracked in .github/tailor.lock (machine-owned: commit it; the only
#   part to edit by hand is appIds, to re-key an app after moving its directory).
name: Tailor Preview (my-app)

on:
  pull_request:
    branches: ["main"]
    types: [opened, synchronize, reopened]
    # To deploy only for PRs that carry the `tailor:preview` label instead of all PRs,
    # re-run: tailor setup ci preview --require label
    # To skip draft PRs until they are marked ready for review,
    # re-run: tailor setup ci preview --require ready

permissions:
  contents: read
  pull-requests: write

# A new run for a pull request cancels the one in progress, including your jobs.
# The cleanup workflow runs in this group too, so closing the pull request
# cancels it as well. Events on a pull request that stays closed get a group of
# their own, so they cannot cancel the cleanup run.
concurrency:
  group: tailor-preview-my-app-${{ github.event.pull_request.state == 'open' && format('pr-{0}', github.event.pull_request.number) || format('run-{0}', github.run_id) }}
  cancel-in-progress: true

jobs:
  tailor-preview-deploy:
    if: |-
      !github.event.pull_request.head.repo.fork &&
      github.event.pull_request.state == 'open'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: my-app
    permissions:
      contents: read
      pull-requests: write
    outputs:
      workspace-id: ${{ steps.tailor-preview-deploy.outputs.workspace-id }}
      workspace-name: ${{ steps.tailor-preview-deploy.outputs.workspace-name }}
      app-url: ${{ steps.tailor-preview-deploy.outputs.app-url }}
    steps:
      - id: tailor-checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - id: tailor-setup
        uses: tailor-platform/actions/setup@77effc033b3cb5fa7660b38571fbeb8361d121e8 # v2.8.0
        with:
          package-manager: pnpm
      - id: tailor-install
        uses: tailor-platform/actions/install@77effc033b3cb5fa7660b38571fbeb8361d121e8 # v2.8.0
        with:
          package-manager: pnpm
      - id: tailor-generate-check
        uses: tailor-platform/actions/generate-check@77effc033b3cb5fa7660b38571fbeb8361d121e8 # v2.8.0
        with:
          package-manager: pnpm
      - id: tailor-drift-check
        uses: tailor-platform/actions/drift-check@77effc033b3cb5fa7660b38571fbeb8361d121e8 # v2.8.0
        with:
          package-manager: pnpm
          fail-on-drift: ${{ vars.TAILOR_PLATFORM_FAIL_ON_DRIFT == 'true' }}
      - id: tailor-preview-deploy
        uses: tailor-platform/actions/preview-deploy@77effc033b3cb5fa7660b38571fbeb8361d121e8 # v2.8.0
        with:
          workspace-name-prefix: my-app
          region: "us-west"
          organization-id: ${{ vars.TAILOR_PLATFORM_ORGANIZATION_ID }}
          folder-id: ${{ vars.TAILOR_PLATFORM_FOLDER_ID }}
          ttl: 7d
          package-manager: pnpm
          platform-client-id: ${{ vars.TAILOR_PLATFORM_MACHINE_USER_CLIENT_ID || secrets.TAILOR_PLATFORM_MACHINE_USER_CLIENT_ID }}
          platform-client-secret: ${{ secrets.TAILOR_PLATFORM_MACHINE_USER_CLIENT_SECRET }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
      - id: tailor-preview-comment
        if: always()
        uses: tailor-platform/actions/preview-comment@77effc033b3cb5fa7660b38571fbeb8361d121e8 # v2.8.0
        with:
          workspace-id: ${{ steps.tailor-preview-deploy.outputs.workspace-id }}
          workspace-name: ${{ steps.tailor-preview-deploy.outputs.workspace-name }}
          status: ${{ job.status == 'success' && 'success' || 'failure' }}
          app-url: ${{ steps.tailor-preview-deploy.outputs.app-url }}
          github-token: ${{ secrets.GITHUB_TOKEN }}

  tailor-preview-result:
    name: tailor-preview-result (my-app)
    # Add your own jobs to needs to count them toward this check; tailor setup keeps them.
    needs:
      - tailor-preview-deploy
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - id: tailor-preview-result
        if: always() && (contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled'))
        run: |
          echo "::error::A job in needs failed or was cancelled."
          exit 1

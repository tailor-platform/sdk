{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": ["-lintignore"],
  "entry": [
    "src/configure/index.ts",
    "src/cli/index.ts",
    "src/cli/lib.ts",
    "src/cli/skills.ts",
    "src/utils/test/index.ts",
    "src/kysely/index.ts",
    "src/plugin/index.ts",
    "src/plugin/builtin/kysely-type/index.ts",
    "src/plugin/builtin/enum-constants/index.ts",
    "src/plugin/builtin/file-utils/index.ts",
    "src/plugin/builtin/seed/index.ts",
    "src/seed/index.ts"
  ],
  "ignore": [
    "scripts/**",
    "e2e/fixtures/**",
    "src/cli/commands/apply/__test_fixtures__/**",
    "src/types/*.ts",
    "zinfer.config.ts"
  ],
  "ignoreDependencies": [
    "@liam-hq/cli",
    "@typescript/native-preview",
    "eslint-plugin-import",
    "serve",
    "tsx",
    "vitest",
    "zinfer"
  ],
  "ignoreBinaries": ["eslint", "knip", "publint", "tsc", "tsgo", "vp", "zinfer"]

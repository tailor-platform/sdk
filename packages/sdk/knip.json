{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "ignore": ["scripts/**", "e2e/fixtures/**"],
  "ignoreDependencies": [
    "@liam-hq/cli",
    "@typescript/native-preview",
    "cross-env",
    "eslint-plugin-import",
    "oxlint",
    "oxlint-tsgolint",
    "serve",
    "tsx"
  ],
  "ignoreBinaries": [
    "vitest",
    "tsdown",
    "cross-env",
    "oxlint",
    "eslint",
    "tsc",
    "tsgo",
    "knip",
    "publint"
  ]
}

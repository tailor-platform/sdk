{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": ["-lintignore"],
  "ignore": [
    "scripts/**",
    "e2e/fixtures/**",
    "src/cli/commands/deploy/__test_fixtures__/**",
    "src/cli/commands/apply/__test_fixtures__/**-compat-out/**",
    "src/types/*.ts",
    "zinfer.config.ts"
  ],
  "ignoreDependencies": ["undici", "@liam-hq/cli", "serve", "vite"],
  "ignoreBinaries": ["knip", "publint"]
}

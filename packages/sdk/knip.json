{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "ignore": ["scripts/**", "e2e/fixtures/**", "src/cli/commands/apply/__test_fixtures__/**"],
  "ignoreDependencies": [
    "@liam-hq/cli",
    "@typescript/native-preview",
    "eslint-plugin-import",
    "oxlint",
    "oxlint-tsgolint",
    "serve",
    "tsx"
  ],
  "ignoreBinaries": ["vitest", "tsdown", "oxlint", "eslint", "tsc", "tsgo", "knip", "publint"]
}

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@tailor-proto/*": ["../tailor-proto/src/*"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./scripts/**/*.ts",
    "./eslint-rules/**/*.ts",
    "./e2e/**/*.ts",
    "./tsdown.config.ts",
    "./vitest.config.ts",
    "./zinfer.config.ts"
  ],
  "exclude": ["node_modules", "dist", "e2e/fixtures", "**/__test_fixtures__/**"]
}

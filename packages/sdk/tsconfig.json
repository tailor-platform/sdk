{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "noUncheckedIndexedAccess": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    // Only `scripts/**` needs this: those files run directly under
    // `node --experimental-strip-types`, which - unlike tsdown/vitest's own
    // resolvers - requires explicit `.ts` extensions on relative imports.
    "allowImportingTsExtensions": true,
    "paths": {
      "@tailor-platform/sdk": ["./src/configure/index.ts"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./scripts/**/*.ts",
    "./eslint-rules/**/*.ts",
    "./e2e/**/*.ts",
    "./knip.ts",
    "./tsdown.config.ts",
    "./vitest.config.ts",
    "./vitest.setup.ts",
    "./zinfer.config.ts"
  ],
  "exclude": ["node_modules", "dist", "e2e/fixtures", "**/__test_fixtures__/**"]
}

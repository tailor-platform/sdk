{
  "name": "@tailor-platform/sdk",
  "version": "1.35.1",
  "description": "Tailor Platform SDK - The SDK to work with Tailor Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk"
  },
  "bin": {
    "tailor-sdk": "./dist/cli/index.mjs",
    "tailor-sdk-skills": "./dist/cli/skills.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "postinstall.mjs",
    "README.md",
    "skills"
  ],
  "type": "module",
  "main": "./dist/configure/index.mjs",
  "types": "./dist/configure/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/configure/index.d.mts",
      "import": "./dist/configure/index.mjs",
      "default": "./dist/configure/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/lib.d.mts",
      "import": "./dist/cli/lib.mjs",
      "default": "./dist/cli/lib.mjs"
    },
    "./test": {
      "types": "./dist/utils/test/index.d.mts",
      "import": "./dist/utils/test/index.mjs",
      "default": "./dist/utils/test/index.mjs"
    },
    "./kysely": {
      "types": "./dist/kysely/index.d.mts",
      "import": "./dist/kysely/index.mjs",
      "default": "./dist/kysely/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.mts",
      "import": "./dist/plugin/index.mjs",
      "default": "./dist/plugin/index.mjs"
    },
    "./plugin/kysely-type": {
      "types": "./dist/plugin/builtin/kysely-type/index.d.mts",
      "import": "./dist/plugin/builtin/kysely-type/index.mjs",
      "default": "./dist/plugin/builtin/kysely-type/index.mjs"
    },
    "./plugin/enum-constants": {
      "types": "./dist/plugin/builtin/enum-constants/index.d.mts",
      "import": "./dist/plugin/builtin/enum-constants/index.mjs",
      "default": "./dist/plugin/builtin/enum-constants/index.mjs"
    },
    "./plugin/file-utils": {
      "types": "./dist/plugin/builtin/file-utils/index.d.mts",
      "import": "./dist/plugin/builtin/file-utils/index.mjs",
      "default": "./dist/plugin/builtin/file-utils/index.mjs"
    },
    "./plugin/seed": {
      "types": "./dist/plugin/builtin/seed/index.d.mts",
      "import": "./dist/plugin/builtin/seed/index.mjs",
      "default": "./dist/plugin/builtin/seed/index.mjs"
    },
    "./seed": {
      "types": "./dist/seed/index.d.mts",
      "import": "./dist/seed/index.mjs",
      "default": "./dist/seed/index.mjs"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest --project=unit",
    "test:e2e": "vitest --project=e2e",
    "test:coverage": "vitest --coverage",
    "docs:check": "vitest run --project=unit src/cli/docs.test.ts",
    "docs:update": "POLITTY_DOCS_UPDATE=true vitest run --project=unit src/cli/docs.test.ts",
    "build": "tsdown",
    "lint": "oxlint --type-aware . && eslint --cache .",
    "lint:fix": "oxlint --type-aware . --fix && eslint --cache . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:go": "tsgo",
    "perf:typecheck": "bash scripts/perf/exec.sh",
    "perf:runtime": "bash scripts/perf/runtime-perf.sh",
    "prepublish": "pnpm run build",
    "postinstall": "node postinstall.mjs",
    "measure:bundle": "node ../../scripts/measure-bundle-size-sonda.js",
    "knip": "knip",
    "publint": "publint --strict",
    "generate": "zinfer && node -e \"const f=require('fs').readdirSync('src/types').filter(f=>f.endsWith('.generated.ts')).map(f=>'src/types/'+f);if(f.length)require('child_process').execSync('pnpm oxfmt --write '+f.join(' '),{stdio:'inherit'})\""
  },
  "dependencies": {
    "@0no-co/graphql.web": "1.2.0",
    "@badgateway/oauth2-client": "3.3.1",
    "@bufbuild/protobuf": "2.11.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-node": "2.1.1",
    "@inquirer/core": "11.1.8",
    "@inquirer/prompts": "8.3.2",
    "@liam-hq/cli": "0.7.24",
    "@napi-rs/keyring": "1.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.214.0",
    "@opentelemetry/resources": "2.6.1",
    "@opentelemetry/sdk-trace-node": "2.6.1",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@oxc-project/types": "0.123.0",
    "@standard-schema/spec": "1.1.0",
    "@tailor-platform/function-kysely-tailordb": "0.1.3",
    "@tailor-platform/function-types": "0.8.4",
    "@toiroakr/lines-db": "0.9.1",
    "@urql/core": "6.0.1",
    "chalk": "5.6.2",
    "chokidar": "5.0.0",
    "confbox": "0.2.4",
    "date-fns": "4.1.0",
    "es-toolkit": "1.45.1",
    "find-up-simple": "1.0.1",
    "globals": "17.4.0",
    "inflection": "3.0.2",
    "kysely": "0.28.15",
    "madge": "8.0.0",
    "mime-types": "3.0.2",
    "multiline-ts": "4.0.1",
    "open": "11.0.0",
    "ora": "9.3.0",
    "oxc-parser": "0.124.0",
    "p-limit": "7.3.0",
    "pathe": "2.0.3",
    "pgsql-ast-parser": "12.0.2",
    "pkg-types": "2.3.0",
    "politty": "0.4.13",
    "rolldown": "1.0.0-rc.13",
    "semver": "7.7.4",
    "serve": "14.2.6",
    "std-env": "4.0.0",
    "table": "6.9.0",
    "ts-cron-validator": "1.1.5",
    "tsx": "4.21.0",
    "type-fest": "5.5.0",
    "xdg-basedir": "5.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@types/madge": "5.0.3",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.12.2",
    "@types/semver": "7.7.1",
    "@typescript/native-preview": "7.0.0-dev.20260406.1",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "10.2.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-oxlint": "1.58.0",
    "oxfmt": "0.44.0",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "0.20.0",
    "sonda": "0.11.1",
    "tsdown": "0.21.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.2",
    "zinfer": "0.1.7"
  }
}

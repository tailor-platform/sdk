{
  "name": "@tailor-platform/sdk-plugin-tailordb-erd",
  "version": "0.1.3",
  "description": "Tailor CLI plugin providing the `tailor tailordb erd` commands (TailorDB ERD viewer)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk-plugin-tailordb-erd"
  },
  "bin": {
    "tailor-tailordb-erd": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && politty generate-shim --entry ../dist/cli.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@politty/valibot": "0.1.1",
    "chokidar": "5.0.0",
    "mime-types": "3.0.2",
    "open": "11.0.0",
    "pathe": "2.0.3",
    "pkg-types": "2.3.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@tailor-platform/sdk": "workspace:^",
    "@tailor-platform/shared": "workspace:^",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.13.3",
    "oxlint": "1.76.0",
    "tsdown": "0.22.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@tailor-platform/sdk": "workspace:^"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.15.0"
  }
}

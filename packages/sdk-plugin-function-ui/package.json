{
  "name": "@tailor-platform/sdk-plugin-function-ui",
  "version": "0.0.0",
  "description": "Tailor CLI plugin providing the `tailor function-ui` command (run a function from the browser, on its own)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk-plugin-function-ui"
  },
  "bin": {
    "tailor-function-ui": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && vite build && politty generate-shim --entry ../dist/cli.js",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@croct/json5-parser": "0.2.2",
    "@politty/zod": "0.7.8",
    "open": "11.0.4",
    "oxfmt": "0.79.0",
    "pathe": "2.0.3",
    "pkg-types": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@enlumine/html": "0.1.0",
    "@enlumine/json": "0.1.2",
    "@enlumine/react": "0.1.0",
    "@tailor-platform/app-shell": "1.20.0",
    "@tailor-platform/sdk": "workspace:^",
    "@tailor-platform/shared": "workspace:^",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "codemirror": "6.0.2",
    "oxlint": "1.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@tailor-platform/sdk": "workspace:^"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}

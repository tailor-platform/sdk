    "semver": "7.8.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailor-platform/shared": "workspace:^",
    "@types/node": "24.13.3",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "eslint-plugin-zod": "4.9.0",
    "oxlint": "1.76.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },

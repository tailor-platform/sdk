{
  "name": "@tailor-platform/sdk-codemod",
  "version": "0.16.0",
  "description": "Codemod runner for Tailor Platform SDK upgrades",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk-codemod"
  },
  "bin": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "pnpm run build",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@ast-grep/napi": "0.51.3",
    "@politty/zod": "0.7.8",
    "diff": "9.0.0",
    "get-tsconfig": "4.14.3",
    "pathe": "2.0.3",
    "picomatch": "4.0.7",
    "pkg-types": "2.4.0",
    "semver": "7.8.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailor-platform/sdk": "workspace:^",
    "@tailor-platform/shared": "workspace:^",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "eslint-plugin-zod": "5.3.0",
    "oxlint": "1.95.0",
    "tsdown": "0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.18.0"
  }
}

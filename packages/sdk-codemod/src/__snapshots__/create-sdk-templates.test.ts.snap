    "tailor.config.ts": "@@ -0,0 +1,14 @@
+import { defineWorkspace } from "@tailor-platform/sdk";
+
+export const sharedDb = "shared-db";
+
+export default defineWorkspace({
+  db: {
+    [sharedDb]: { files: [\`./apps/user/db/**/*.ts\`, "!apps/user/**/*.test.ts", "!apps/user/**/*.spec.ts"] },
+    "admin-db": { files: [\`./apps/admin/db/**/*.ts\`, "!apps/admin/**/*.test.ts", "!apps/admin/**/*.spec.ts"] },
+  },
+  apps: {
+    user: { db: [sharedDb] },
+    admin: { db: [sharedDb, "admin-db"] },
+  },
+});
",
  },

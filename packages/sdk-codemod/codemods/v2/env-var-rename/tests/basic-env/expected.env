TAILOR_CONFIG_PATH=tailor.config.ts
TAILOR_DTS_PATH=types/tailor.d.ts
TAILOR_CI_ALLOW_ID_INJECTION=true
TAILOR_DEPLOY_BUILD_ONLY=true
TAILOR_BUILD_OUTPUT_DIR=.tailor-sdk
TAILOR_SKILLS_SOURCE=./skills
TAILOR_TEMPLATE_SDK_VERSION=2.0.0-next.2
TAILOR_PLATFORM_URL=https://api.staging.tailor.tech
TAILOR_PLATFORM_OAUTH2_CLIENT_ID=client-id
TAILOR_INLINE_SOURCEMAP=false
TAILOR_QUERY_NEWLINE_ON_ENTER=false
TAILOR_APP_LOG_LEVEL=DEBUG
TAILOR_PLATFORM_TOKEN=token

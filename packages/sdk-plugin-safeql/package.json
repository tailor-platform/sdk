{
  "name": "@tailor-platform/sdk-plugin-safeql",
  "version": "0.0.0",
  "description": "Type-check raw SQL written against TailorDB tables with SafeQL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-platform/sdk.git",
    "directory": "packages/sdk-plugin-safeql"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build",
    "publint": "publint --strict"
  },
  "devDependencies": {
    "@tailor-platform/sdk": "workspace:^",
    "@types/node": "24.19.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@tailor-platform/sdk": "workspace:^"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

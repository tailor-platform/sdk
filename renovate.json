{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tailor-inc/renovate-config",
    "github>aquaproj/aqua-renovate-config#2.12.0",
    ":pinAllExceptPeerDependencies",
    ":disableDependencyDashboard"
  ],
  "gitIgnoredAuthors": ["247949890+tailor-pr-trigger[bot]@users.noreply.github.com"],
  "dependencyDashboardApproval": false,
  "timezone": "Asia/Tokyo",
  "schedule": ["* 9-18 * * 1-5"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["packages/sdk/src/cli/commands/setup/github/.+\\.ya?ml$"],
      "matchStrings": [
        "uses:\\s+(?<depName>[\\w-]+/[\\w-]+)@(?<currentDigest>[a-f0-9]+)\\s+#\\s+(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Enable major updates without dashboard approval (dashboard is disabled)",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@connectrpc/*"],
      "groupName": "@connectrpc"
    }
  ]
}

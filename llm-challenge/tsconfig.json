{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "@tailor-platform/function-types"]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "problems/*/work",
    "problems/*/work-*",
    "problems/*/solution",
    "problems/*/scaffold",
    "problems/*/variants/*/solution",
    "problems/*/variants/*/scaffold"
  ]
}

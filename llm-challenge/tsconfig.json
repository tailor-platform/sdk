{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "problems/*/work",
    "problems/*/solution",
    "problems/*/scaffold"
  ]
}

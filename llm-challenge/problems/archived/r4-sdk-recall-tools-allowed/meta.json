{
  "id": "r4-sdk-recall-tools-allowed",
  "title": "Implementation-framed recall with SDK exploration allowed",
  "designNote": "tool_access_isolation",
  "sdkSurface": "*",
  "contextProfiles": ["full", "no-docs"],
  "mode": "recall",
  "recallSystem": [
    "You are implementing an @tailor-platform/sdk project. For each surface listed below, write the one-line `firstImport` and `firstCall` you would put at the top of an implementation file that must compile against the SDK.",
    "{{VERSION}}",
    "{{PROFILE}}",
    "You MAY read files under node_modules/@tailor-platform/sdk/ and you MAY run shell commands to look up SDK declarations.",
    "Do NOT create, modify, or delete any file in the current working directory.",
    "End your response with a single fenced JSON block containing the surfaces[] answer."
  ],

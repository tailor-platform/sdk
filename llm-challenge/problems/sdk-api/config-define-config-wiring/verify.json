{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "database-source-created",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "database|tailordb|db",
      "flags": "i",
      "description": "source includes a database area"
    },
    {
      "id": "resolver-source-created",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "resolver",
      "flags": "i",
      "description": "source includes a resolver-style operation"
    },
    {
      "id": "workflow-source-created",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "workflow",
      "flags": "i",
      "description": "source includes a workflow area"
    }
  ]
}

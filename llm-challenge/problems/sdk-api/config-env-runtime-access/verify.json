{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "runtime-config-defined",
      "kind": "content-match",
      "glob": "**/tailor.config.ts",
      "pattern": "\\benv\\s*:",
      "description": "top-level Tailor config defines runtime configuration values"
    },
    {
      "id": "resolver-env-used",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "createResolver[\\s\\S]*\\benv\\.",
      "flags": "i",
      "description": "resolver-style source reads values from the SDK-provided env object"
    },
    {
      "id": "executor-env-used",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "createExecutor[\\s\\S]*\\benv\\.",
      "flags": "i",
      "description": "executor-style source reads values from the SDK-provided env object"
    },
    {
      "id": "workflow-env-used",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "createWorkflowJob[\\s\\S]*\\benv\\.",
      "flags": "i",
      "description": "workflow job source reads values from the SDK-provided env object"
    },
    {
      "id": "auth-hook-env-used",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "beforeLogin[\\s\\S]*\\benv\\.",
      "flags": "i",
      "description": "authentication hook source reads values from the SDK-provided env object"
    },
    {
      "id": "explanation-note-created",
      "kind": "file-glob",
      "glob": "**/*.md",
      "minCount": 1,
      "description": "workspace includes the requested note about runtime configuration"
    }
  ]
}

{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "resolver-source-created",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "resolver",
      "flags": "i",
      "description": "source includes a resolver-style operation"
    },
    {
      "id": "executor-source-created",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "executor|handler",
      "flags": "i",
      "description": "source includes an executor-style handler"
    },
    {
      "id": "audit-payload-includes-time",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "audit|timestamp|Date",
      "flags": "i",
      "description": "source records an audit payload with time information"
    }
  ]
}

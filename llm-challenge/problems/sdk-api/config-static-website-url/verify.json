{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "website-source-created",
      "kind": "file-glob",
      "glob": "**/*.html",
      "minCount": 1,
      "description": "workspace includes a static website HTML entry point"
    },
    {
      "id": "public-url-configured",
      "kind": "content-match",
      "glob": "**/*.ts",
      "pattern": "https?://|defineStaticWebSite[\\s\\S]*\\.url\\b",
      "flags": "i",
      "description": "configuration contains a public website URL or SDK URL reference"
    }
  ]
}

{
  "name": "llm-challenge",
  "private": true,
  "description": "Challenge problems for evaluating LLM implementations with @tailor-platform/sdk",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "challenge": "tsx core/cli.ts",
    "challenge:verify-solution": "tsx core/cli.ts --all --use-solution",
    "challenge:solve": "tsx core/cli.ts --all --solve",
    "challenge:analyze": "tsx core/analyze.ts",
    "challenge:experiment": "tsx core/experiment.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:go": "tsgo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.94.0",
    "@tailor-platform/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">= 22.14.0"
  }
}

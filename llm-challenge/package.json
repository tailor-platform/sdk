{
  "name": "llm-challenge",
  "private": true,
  "description": "Challenge problems for evaluating LLM implementations with @tailor-platform/sdk",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "challenge": "tsx runner/run.ts",
    "challenge:verify-solution": "tsx runner/run.ts --all --use-solution",
    "challenge:solve": "tsx runner/run.ts --all --solve",
    "challenge:analyze": "tsx runner/analyze.ts",
    "test:runner": "vitest run --config vitest.runner.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:go": "tsgo"
  },
  "dependencies": {
    "@tailor-platform/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">= 22.14.0"
  }
}
